# Required
DISCORD_TOKEN=
GUILD_ID=

# Container paths (do not change unless you remap the volume)
DATABASE_PATH=/app/data/relay.db
LOG_LEVEL=INFO

# Hub role names (must match your Discord server)
NETWORK_ACCESS_ROLE_NAME=The Network
NETWORK_OPERATOR_ROLE_NAME=The Network+

# Optional
DISCORD_APPLICATION_ID=
TOPGG_TOKEN=
