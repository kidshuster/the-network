# Required
DISCORD_TOKEN=
GUILD_ID=

# Developer Portal → General Information (optional for gateway bots)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Bootstrap / runtime
DATABASE_PATH=./data/relay.db
# For a burn-in staging guild, copy this file to .env.staging with a separate
# GUILD_ID and DATABASE_PATH (e.g. ./data/staging.db). See docs/smoke-testing.md.
LOG_LEVEL=INFO
PROFILE_FORUM_CHANNEL_ID=
# Optional bootstrap default; prefer /profile set-forum in Discord.
RELAY_LOG_CHANNEL_ID=
MANUAL_RELAY_ENABLED=false
NETWORK_ACCESS_ROLE_NAME=The Network
NETWORK_OPERATOR_ROLE_NAME=The Network+
